PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthcare_db?schema=public"
JWT_SECRET="your_super_secret_jwt_key_change_me"

# Gemini 2.0 Flash AI Triage & Post-Visit Summary Key
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-2.0-flash"

# Live Gmail SMTP + Nodemailer Setup
ENABLE_EMAIL_NOTIFICATIONS=true
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER="your-healthpulse-gmail@gmail.com"
EMAIL_PASS="your-16-character-app-password"
EMAIL_FROM="HealthPulse Hospital <your-healthpulse-gmail@gmail.com>"
EMAIL_TEST_MODE=false
EMAIL_TEST_RECIPIENT="ktarpita@gmail.com"

# Google Calendar OAuth Credentials
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:5000/api/auth/google/callback"
CLIENT_URL="http://localhost:5173"
